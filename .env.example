# ===========================================
# ArsCulinaria — Variables de entorno
# ===========================================
# Copia este archivo como .env y rellena los valores necesarios.

# ------ Instagram Graph API (Opcional) ------
# Lo usa /api/instagram-views para mostrar las visualizaciones de cada publicación.
# Necesitas una cuenta profesional de Instagram y una app de Meta con la API de Instagram.
# Guía: https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=

# Visualizaciones a partir de las que una publicación se marca como «Tendencia» (1000 por defecto)
INSTAGRAM_TRENDING_THRESHOLD=1000
