---
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRecipes } from '../../lib/content';

const recipes = await getRecipes();
---

<BaseLayout title="Recetas" description="Las recetas que cocinamos en casa y que nos gusta compartir.">
	<PageHeader
		eyebrow="Desde nuestra cocina"
		title="Recetas"
		intro="De vez en cuando nos ponemos detrás de los fogones. Estas son las recetas que repetimos y que nos piden los amigos."
	/>

	<section class="container-page" aria-label="Listado de recetas">
		{
			recipes.length > 0 ? (
				<div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
					{recipes.map((recipe, index) => (
						<PostCard
							href={`/recipes/${recipe.id}/`}
							title={recipe.data.title}
							description={recipe.data.description}
							date={recipe.data.pubDate}
							image={recipe.data.image}
							headingLevel="h2"
							priority={index < 3}
						/>
					))}
				</div>
			) : (
				<p class="rounded-2xl border border-dashed border-line px-6 py-16 text-center text-muted">
					Todavía no hay recetas. ¡Pronto!
				</p>
			)
		}
	</section>
</BaseLayout>
