---
import { Image } from 'astro:assets';
import Logo from '../../components/Logo.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatCategory, getSuggestions } from '../../lib/content';

const suggestions = await getSuggestions();

const LINK_LABELS = {
	website: 'Web',
	instagram: 'Instagram',
	menu: 'Carta',
	reservations: 'Reservar',
	googleMaps: 'Mapa',
} as const;
---

<BaseLayout
	title="Por visitar"
	description="Restaurantes que nos han recomendado y todavía no hemos visitado. Nuestra lista de pendientes."
>
	<PageHeader
		eyebrow={`${suggestions.length} ${suggestions.length === 1 ? 'pendiente' : 'pendientes'}`}
		title="Por visitar"
		intro="Restaurantes que nos han recomendado y todavía no hemos probado. Cuando vayamos, tendrán su reseña."
	/>

	<section class="container-page" aria-label="Restaurantes por visitar">
		{
			suggestions.length > 0 ? (
				<ul class="flex flex-col gap-10">
					{suggestions.map(({ data }) => {
						const links = Object.entries(LINK_LABELS).flatMap(([key, label]) => {
							const href = data.restaurantLinks?.[key as keyof typeof LINK_LABELS];
							return href ? [{ href, label }] : [];
						});
						return (
							<li>
								<article class="grid gap-6 rounded-3xl border border-line bg-surface p-4 sm:p-5 md:grid-cols-[2fr_3fr] md:gap-10">
									<div class="relative aspect-[3/2] overflow-hidden rounded-2xl bg-sand md:aspect-auto md:min-h-64">
										{data.image ? (
											<Image
												src={data.image}
												alt=""
												widths={[400, 600, 800]}
												sizes="(min-width: 768px) 40vw, 100vw"
												class="absolute inset-0 size-full object-cover"
											/>
										) : (
											<div class="grid size-full place-items-center">
												<Logo class="size-12 opacity-40" />
											</div>
										)}
										{data.priority && (
											<p class="absolute top-3 left-3 rounded-full bg-accent px-3 py-1 text-xs font-semibold tracking-wide text-paper uppercase">
												Prioridad
											</p>
										)}
									</div>

									<div class="flex flex-col justify-center pb-2 md:py-4 md:pr-4">
										<p class="text-xs font-medium tracking-wide text-muted uppercase">
											<span class="text-ink">{data.locality}</span>
											{data.categoryArray.length > 0 && (
												<>
													<span aria-hidden="true" class="mx-1.5">·</span>
													<span class="text-accent">{data.categoryArray.map(formatCategory).join(' · ')}</span>
												</>
											)}
										</p>
										<h2 class="mt-3 text-3xl">{data.title}</h2>
										{data.recommendedBy && (
											<p class="mt-2 text-sm text-muted">Recomendado por {data.recommendedBy}</p>
										)}
										<p class="mt-4 leading-relaxed text-ink-soft">{data.description}</p>
										<p class="mt-4 text-sm text-muted">{data.address}</p>
										{links.length > 0 && (
											<ul class="mt-6 flex flex-wrap gap-2" aria-label={`Enlaces de ${data.title}`}>
												{links.map((link) => (
													<li>
														<a
															href={link.href}
															target="_blank"
															rel="noopener noreferrer"
															class="inline-flex items-center gap-1.5 rounded-full border border-line px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-ink"
														>
															{link.label}
															<span aria-hidden="true">↗</span>
															<span class="sr-only">(se abre en una pestaña nueva)</span>
														</a>
													</li>
												))}
											</ul>
										)}
									</div>
								</article>
							</li>
						);
					})}
				</ul>
			) : (
				<p class="rounded-2xl border border-dashed border-line px-6 py-16 text-center text-muted">
					No tenemos recomendaciones pendientes. ¡Pronto añadiremos sitios nuevos!
				</p>
			)
		}
	</section>
</BaseLayout>
