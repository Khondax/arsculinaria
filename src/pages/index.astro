---
import { Image } from 'astro:assets';
import FavoritesCarousel from '../components/FavoritesCarousel.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRecipes, getReviews, reviewCardProps } from '../lib/content';
import aboutPhoto from '../assets/images/nosotros.jpg';

const MAX_FEATURED = 10;
const MAX_LATEST = 3;

const reviews = await getReviews();
const recipes = await getRecipes();

// Las 10 destacadas más recientes; si no hay ninguna marcada, las más recientes.
const important = reviews.filter((review) => review.data.important);
const featured = (important.length > 0 ? important : reviews).slice(0, MAX_FEATURED);
const [lead, ...restFeatured] = featured;
const latest = reviews.filter((review) => !featured.includes(review)).slice(0, MAX_LATEST);
const favorites = reviews.filter((review) => review.data.favorite);

const oldest = reviews.at(-1);
const stats = [
	{ value: reviews.length, label: reviews.length === 1 ? 'reseña' : 'reseñas' },
	{ value: recipes.length, label: recipes.length === 1 ? 'receta' : 'recetas' },
	...(oldest ? [{ value: oldest.data.pubDate.getFullYear(), label: 'reseñando desde' }] : []),
];
---

<BaseLayout>
	<!-- Hero -->
	<section class="container-page pt-16 pb-20 md:pt-28 md:pb-28">
		<p class="eyebrow">Diario gastronómico · Gran Canaria</p>
		<h1 class="mt-6 max-w-4xl text-5xl leading-[1.02] sm:text-6xl md:text-7xl lg:text-8xl">
			Bienvenidos a <em class="font-normal text-accent italic">nuestra mesa</em>
		</h1>
		<p class="mt-8 max-w-xl text-lg leading-relaxed text-muted md:text-xl">
			Somos Miguel y Lucía. Aquí guardamos los restaurantes que vamos probando, con lo que más nos gustó
			y lo que no, para que podáis disfrutarlos tanto como nosotros.
		</p>

		<div class="mt-10 flex flex-wrap items-center gap-3">
			<a
				href="/reviews"
				class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent"
			>
				Ver todas las reseñas
			</a>
			<a
				href="/buscador"
				class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ink"
			>
				Buscar un sitio
			</a>
		</div>

		<dl class="mt-16 flex flex-wrap gap-x-12 gap-y-6 border-t border-line pt-8">
			{
				stats.map((stat) => (
					<div class="flex flex-col-reverse">
						<dt class="text-sm text-muted">{stat.label}</dt>
						<dd class="font-display text-4xl text-ink">{stat.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<!-- Destacadas -->
	{
		lead && (
			<section class="container-page" aria-labelledby="destacadas">
				<div class="flex items-end justify-between gap-6 border-b border-line pb-6">
					<h2 id="destacadas" class="text-3xl md:text-4xl">
						Destacadas
					</h2>
					<a href="/reviews" class="text-sm font-medium text-accent transition-colors hover:text-accent-dark">
						Ver todas →
					</a>
				</div>

				<div class="mt-10">
					<PostCard
						{...reviewCardProps(lead)}
						variant="feature"
						priority
					/>
				</div>

				{restFeatured.length > 0 && (
					<div class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
						{restFeatured.map((review) => (
							<PostCard
								{...reviewCardProps(review)}
							/>
						))}
					</div>
				)}
			</section>
		)
	}

	<!-- Favoritos -->
	{
		favorites.length > 0 && (
			<section class="container-page mt-24" aria-labelledby="favoritos">
				<div class="flex items-end justify-between gap-6 border-b border-line pb-6">
					<h2 id="favoritos" class="text-3xl md:text-4xl">
						Nuestros favoritos
					</h2>
				</div>
				<div class="mt-10">
					<FavoritesCarousel favorites={favorites} />
				</div>
			</section>
		)
	}

	<!-- Últimas -->
	{
		latest.length > 0 && (
			<section class="container-page mt-24" aria-labelledby="recientes">
				<div class="flex items-end justify-between gap-6 border-b border-line pb-6">
					<h2 id="recientes" class="text-3xl md:text-4xl">
						Recién publicadas
					</h2>
				</div>
				<div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
					{latest.map((review) => (
						<PostCard
							{...reviewCardProps(review)}
						/>
					))}
				</div>
			</section>
		)
	}

	<!-- Sobre nosotros -->
	<section class="container-page mt-28">
		<div class="grid overflow-hidden rounded-3xl bg-ink text-paper md:grid-cols-2">
			<div class="relative aspect-[4/3] md:aspect-auto md:min-h-[28rem]">
				<Image
					src={aboutPhoto}
					alt="Miguel y Lucía brindando con vino tinto en un restaurante"
					widths={[480, 720, 960]}
					sizes="(min-width: 768px) 50vw, 100vw"
					class="absolute inset-0 size-full object-cover"
				/>
			</div>
			<div class="flex flex-col justify-center p-8 sm:p-12 lg:p-16">
				<p class="eyebrow text-accent-soft">Quiénes somos</p>
				<h2 class="mt-4 text-4xl text-paper md:text-5xl">Más de 440 sitios en nuestra lista</h2>
				<p class="mt-6 leading-relaxed text-paper/75">
					No somos críticos gastronómicos ni lo pretendemos. Solo queremos llevar un diario sencillo de los
					sitios que probamos y compartirlo con quien le sirva.
				</p>
				<a
					href="/about"
					class="mt-8 inline-flex w-fit items-center gap-2 rounded-full bg-paper px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-accent-soft"
				>
					Conócenos <span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
