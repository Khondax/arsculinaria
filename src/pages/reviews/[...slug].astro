---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import InstagramEmbed from '../../components/InstagramEmbed.astro';
import PostCard from '../../components/PostCard.astro';
import ReviewFacts from '../../components/ReviewFacts.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import PostLayout from '../../layouts/PostLayout.astro';
import { getRelatedReviews, getReviews, reviewCardProps, type Review } from '../../lib/content';

export const getStaticPaths = (async () => {
	const reviews = await getReviews();
	return reviews.map((review) => ({
		params: { slug: review.id },
		props: { review, related: getRelatedReviews(review, reviews) },
	}));
}) satisfies GetStaticPaths;

interface Props {
	review: Review;
	related: Review[];
}

const { review, related } = Astro.props;
const { Content } = await render(review);
const { data } = review;

const badges = [data.favorite && 'Favorito', data.trending && 'Tendencia'].filter((b): b is string => Boolean(b));
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<PostLayout
	title={data.title}
	description={data.description}
	pubDate={data.pubDate}
	updatedDate={data.updatedDate}
	image={data.image}
	categories={data.categoryArray}
	badges={badges}
	back={{ href: '/reviews', label: 'Todas las reseñas' }}
>
	<ReviewFacts slot="aside" data={data} />

	{
		data.anecdote && (
			<aside slot="lead" class="mb-12 rounded-2xl bg-accent-soft px-6 py-5">
				<p class="eyebrow">Anécdota</p>
				<p class="mt-2 font-display text-xl leading-relaxed text-ink italic">{data.anecdote}</p>
			</aside>
		)
	}

	<Content />

	<Fragment slot="end">
		{data.instagramPostId && <InstagramEmbed post={data.instagramPostId} />}
		<div class="mt-12 border-t border-line pt-8">
			<ShareButtons url={shareUrl} title={data.title} />
		</div>
	</Fragment>

	{
		related.length > 0 && (
			<section slot="after" class="container-page mt-24 border-t border-line pt-16">
				<div class="flex items-end justify-between gap-6">
					<h2 class="text-3xl md:text-4xl">Sigue leyendo</h2>
					<a href="/reviews" class="text-sm font-medium text-accent hover:text-accent-dark">
						Ver todas →
					</a>
				</div>
				<div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
					{related.map((r) => (
						<PostCard {...reviewCardProps(r)} />
					))}
				</div>
			</section>
		)
	}
</PostLayout>
