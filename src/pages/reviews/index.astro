---
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReviews } from '../../lib/content';

const reviews = await getReviews();
---

<BaseLayout title="Reseñas" description="Todas nuestras reseñas de restaurantes, de la más reciente a la más antigua.">
	<PageHeader
		eyebrow={`${reviews.length} reseñas`}
		title="Todas nuestras mesas"
		intro="Cada sitio que hemos probado, del más reciente al más antiguo, contado con sinceridad."
	>
		<a
			href="/buscador"
			class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-accent-dark"
		>
			¿Buscas algo concreto? Usa el buscador <span aria-hidden="true">→</span>
		</a>
	</PageHeader>

	<section class="container-page" aria-label="Listado de reseñas">
		<div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
			{
				reviews.map((review, index) => (
					<PostCard
						href={`/reviews/${review.id}/`}
						title={review.data.title}
						description={review.data.description}
						date={review.data.pubDate}
						image={review.data.image}
						averagePrice={review.data.averagePrice}
						categories={review.data.categoryArray}
						headingLevel="h2"
						priority={index < 3}
					/>
				))
			}
		</div>
	</section>
</BaseLayout>
