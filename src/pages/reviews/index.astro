---
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReviews, reviewCardProps } from '../../lib/content';

const reviews = await getReviews();
---

<BaseLayout title="Reseñas" description="Todas nuestras reseñas de restaurantes, de la más reciente a la más antigua.">
	<PageHeader
		eyebrow={`${reviews.length} reseñas`}
		title="Todas nuestras mesas"
		intro="Cada sitio que hemos probado, del más reciente al más antiguo, contado con sinceridad."
	>
		<div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium">
			<a href="/buscador" class="inline-flex items-center gap-2 text-accent transition-colors hover:text-accent-dark">
				¿Buscas algo concreto? Usa el buscador <span aria-hidden="true">→</span>
			</a>
			<a href="/categorias" class="inline-flex items-center gap-2 text-accent transition-colors hover:text-accent-dark">
				Explorar por categoría <span aria-hidden="true">→</span>
			</a>
		</div>
	</PageHeader>

	<section class="container-page" aria-label="Listado de reseñas">
		<div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
			{
				reviews.map((review, index) => (
					<PostCard
						{...reviewCardProps(review)}
						headingLevel="h2"
						priority={index < 3}
					/>
				))
			}
		</div>
	</section>
</BaseLayout>
