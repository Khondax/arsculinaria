---
// Marca del sitio: un plato visto desde arriba. Misma forma que `public/favicon.svg`.
interface Props {
	class?: string;
}

const { class: className = 'size-8' } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
	<rect width="32" height="32" rx="9" fill="var(--color-accent)"></rect>
	<circle cx="16" cy="16" r="9" fill="none" stroke="var(--color-paper)" stroke-width="1.75"></circle>
	<circle cx="16" cy="16" r="5.25" fill="none" stroke="var(--color-paper)" stroke-width="1" opacity="0.65"
	></circle>
</svg>
