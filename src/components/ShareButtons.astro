---
// Botones para compartir una página. Sin JS salvo «Copiar enlace»; si el navegador admite la
// Web Share API, añade «Compartir» con el menú nativo del sistema.
import SocialIcon from './SocialIcon.astro';

interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const button =
	'inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-ink';
---

<div class="flex flex-wrap items-center gap-2" data-share={url} data-share-title={title}>
	<p class="mr-2 text-sm font-medium text-muted">Compartir</p>
	<a href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener noreferrer" class={button}>
		<svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
			<path
				d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.42.25-.69.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 7c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"
			></path>
		</svg>
		WhatsApp
	</a>
	<a href={`https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class={button}>
		<SocialIcon network="x" class="size-3.5" />
		X
	</a>
	<a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class={button}>
		<svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
			<path
				d="M24 12.07C24 5.45 18.63.07 12 .07S0 5.45 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.47h-2.8v8.38C19.61 23.03 24 18.06 24 12.07"
			></path>
		</svg>
		Facebook
	</a>
	<button type="button" class={button} data-share-copy>
		<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
			<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
		</svg>
		<span data-share-copy-label>Copiar enlace</span>
	</button>
	<button type="button" class:list={[button, 'hidden']} data-share-native>Más opciones</button>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-share]')) {
		const url = root.dataset.share ?? location.href;
		const title = root.dataset.shareTitle ?? document.title;

		const copy = root.querySelector<HTMLButtonElement>('[data-share-copy]');
		const label = root.querySelector<HTMLElement>('[data-share-copy-label]');
		copy?.addEventListener('click', async () => {
			if (!label) return;
			try {
				await navigator.clipboard.writeText(url);
				label.textContent = '¡Copiado!';
			} catch {
				label.textContent = 'No se pudo copiar';
			}
			setTimeout(() => (label.textContent = 'Copiar enlace'), 2000);
		});

		const native = root.querySelector<HTMLButtonElement>('[data-share-native]');
		if (native && 'share' in navigator) {
			native.classList.remove('hidden');
			native.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
		}
	}
</script>
