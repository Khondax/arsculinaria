---
// Publicación de Instagram incrustada, con sus visualizaciones si `/api/instagram-views` está
// configurado. Sin JS queda un enlace a la publicación.
interface Props {
	/** Código de la publicación: lo que va tras `/p/` en su URL. */
	post: string;
}

const { post } = Astro.props;
const permalink = `https://www.instagram.com/p/${post}/`;
---

<section class="mt-16 rounded-3xl border border-line bg-surface p-6 sm:p-8" aria-labelledby="instagram" data-instagram={post}>
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h2 id="instagram" class="text-2xl">En Instagram</h2>
		<p class="flex items-center gap-2 text-sm text-muted" hidden data-instagram-stats>
			<span data-instagram-views></span>
			<span class="rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-paper" hidden data-instagram-trending>
				Tendencia
			</span>
		</p>
	</div>
	<blockquote class="instagram-media mx-auto mt-6 w-full max-w-[540px]" data-instgrm-permalink={permalink} data-instgrm-version="14">
		<a href={permalink} target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-4">
			Ver la publicación en Instagram
		</a>
	</blockquote>
</section>

<script>
	const root = document.querySelector<HTMLElement>('[data-instagram]');
	const post = root?.dataset.instagram;

	if (root && post) {
		const script = document.createElement('script');
		script.src = 'https://www.instagram.com/embed.js';
		script.async = true;
		document.body.append(script);

		fetch(`/api/instagram-views?post=${encodeURIComponent(post)}`)
			.then((response) => (response.ok ? response.json() : null))
			.then((data: { views: number | null; isTrending: boolean } | null) => {
				if (!data || !data.views) return;
				const stats = root.querySelector<HTMLElement>('[data-instagram-stats]');
				const views = root.querySelector<HTMLElement>('[data-instagram-views]');
				const trending = root.querySelector<HTMLElement>('[data-instagram-trending]');
				if (!stats || !views || !trending) return;
				views.textContent = `${data.views.toLocaleString('es-ES')} visualizaciones`;
				trending.hidden = !data.isTrending;
				stats.hidden = false;
			})
			// Las visualizaciones son opcionales: sin API (por ejemplo, en local) no se muestran.
			.catch(() => {});
	}
</script>
